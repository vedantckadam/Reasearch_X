# Database Configuration
DATABASE_URL=sqlite:///./researchgapx.db

# LLM Configuration (OpenRouter or NVIDIA)
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
LLM_TIMEOUT=60

# Optional OpenRouter Reasoning Settings (disabled by default)
# OPENROUTER_REASONING_ENABLED=false
# OPENROUTER_REASONING_EFFORT=medium

# Legacy / Alternative Direct NVIDIA API Configuration
NVIDIA_NEMOTRON_API_KEY=your_nvidia_api_key_here
NVIDIA_NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NEMOTRON_MODEL=nvidia/nemotron-4-340b-instruct

# Optional External API Keys (literature retrieval functions without these, but keys increase rate limits)
SEMANTIC_SCHOLAR_API_KEY=your_semantic_scholar_api_key_here

# Retrieval Tuning
RETRIEVAL_MAX_PAPERS=100
OPENALEX_RESULTS_PER_QUERY=25
SEMANTIC_SCHOLAR_RESULTS_PER_QUERY=25
